#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
fail=0
for f in "$ROOT"/bin/* "$ROOT"/lib/*.sh "$ROOT"/tests/*.sh; do
  [[ -f "$f" ]] || continue
  bash -n "$f" || fail=1
done
[[ $fail -eq 0 ]] || exit 1
"$ROOT/tests/selftest.sh"
[[ -f "$ROOT/conf/oracle-native-standby.drv" ]] || { echo "Missing conf/oracle-native-standby.drv"; exit 1; }
[[ "$(stat -c %a "$ROOT/conf/oracle-native-standby.drv")" == 600 ]] || { echo "Driver permissions must be 600"; exit 1; }
echo "PACKAGE VALIDATION PASS"
