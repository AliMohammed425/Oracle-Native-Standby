# Oracle-Native-Standby production driver file.
# Fill required values before non-interactive execution.
# If drv-all is run while required values are blank, the toolkit prompts.
# chmod 600 conf/oracle-native-standby.drv

SOURCE_DB_NAME=
SOURCE_DB_UNIQUE_NAME=
SOURCE_SID=
SOURCE_HOST=
SOURCE_OS_USER=oracle
SOURCE_ORACLE_HOME=
SOURCE_LISTENER_PORT=1521
SOURCE_SERVICE=
SOURCE_IS_CDB=YES
SOURCE_TNS_ALIAS=
SOURCE_SYS_PASSWORD=

TARGET_DB_NAME=
TARGET_DB_UNIQUE_NAME=
TARGET_SID=
TARGET_HOST=
TARGET_OS_USER=oracle
TARGET_PROVISION_OS_USER=opc
TARGET_ORACLE_HOME=
TARGET_LISTENER_PORT=1521
TARGET_AUX_PORT=1529
TARGET_AUX_LISTENER_NAME=LISTENER_ONS
TARGET_SERVICE=
TARGET_TNS_ALIAS=
TARGET_SYS_PASSWORD=
TARGET_ADMIN_PASSWORD=

OCI_TARGET_PLATFORM=AUTO
TARGET_DB_CREATE_FILE_DEST=+DATA
TARGET_DB_RECOVERY_FILE_DEST=+RECO
TARGET_DB_RECOVERY_FILE_DEST_SIZE=500G

STANDBY_BUILD_METHOD=ACTIVE_DUPLICATE
SOURCE_BACKUP_STAGE=
TARGET_BACKUP_STAGE=
BACKUP_COPY_METHOD=SCP

TARGET_RAC_ENABLED=NO
TARGET_RAC_INSTANCES=2
TARGET_GRID_HOME=
TARGET_UNDO_PREFIX=UNDOTBS
TARGET_REDO_SIZE_MB=0
RAC_CONVERSION_MODE=VALIDATE_ONLY

SYNC_WAIT_SECONDS=1800
SYNC_POLL_SECONDS=15
SOURCE_TDE_WALLET_PATH=
TARGET_TDE_WALLET_PATH=
# NONE | TARGET_ONLINE_AFTER_SWITCHOVER | TARGET_OFFLINE_AFTER_BUILD
TDE_ENCRYPTION_MODE=NONE
TDE_ENCRYPT_ALGORITHM=AES256
# For a CDB, set the PDB name to encrypt. Leave blank for the current container/non-CDB.
TDE_ENCRYPT_CONTAINER=
DG_ARCHIVE_DEST_ID=
FULL_BUILD_BACKGROUND=YES


# Operator security policy
# Run the toolkit as ops. Database SSH is performed as oracle.
TOOLKIT_OS_USER=ops
ORACLE_OS_USER=oracle
REQUIRE_LOCAL_SUDO_ORACLE=YES
REQUIRE_TARGET_ORACLE_SSH=YES
REQUIRE_SOURCE_ORACLE_SSH=YES
SSH_CONNECT_TIMEOUT=10
